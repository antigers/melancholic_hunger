{
    "schemaVersion": 1,
    "id": "melancholic_hunger",
    "version": "${version}",
    "name": "Melancholic Hunger & HUD",
    "description": "Removes hunger system, simplifies HUD for Beta-like experience, and adds other features",
    "authors": [
        "antigers"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/melancholic_hunger",
        "sources": "https://github.com/antigers/melancholic_hunger",
        "issues": "https://github.com/antigers/melancholic_hunger/issues"
    },
    "license": "LGPL-3.0",
    "icon": "assets/melancholic_hunger/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "antigers.melancholic_hunger.MelancholicHunger"
        ],
        "modmenu": [
            "antigers.melancholic_hunger.ModMenuScreen"
        ],
        "cardinal-components-entity": [
            "antigers.melancholic_hunger.components.PlayerComponents"
        ]
    },
    "mixins": [
        "melancholic_hunger.mixins.json",
        "nostalgic_tweaks.mixins.json",
        "farmers_delight.mixins.json"
    ],
    "depends": {
        "fabricloader": "*",
        "minecraft": "1.21.1",
        "java": ">=21",
        "fabric-api": "*",
        "yet_another_config_lib_v3": "*"
    },
    "accessWidener": "melancholic_hunger.accesswidener",
    "custom": {
        "cardinal-components": [
            "melancholic_hunger:health_regeneration",
            "melancholic_hunger:server_config"
        ]
    }
}